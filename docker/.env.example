# wg-panel Docker install — copy this file to .env and edit it:
#   cp .env.example .env
# Only the *first* bootstrap builds config.json from these values. After that
# data/panel/config.json is the source of truth and editing .env does not
# change an existing configuration — except the ports published by compose,
# which are always read from here.
#
# پیکربندیِ نصبِ Docker ِ wg-panel — این فایل را به .env کپی و ویرایش کنید.
# فقط «نخستین» بوت‌استرپ از این مقادیر config.json می‌سازد؛ بعد از آن مرجعْ
# خودِ data/panel/config.json است.

# ── Required · الزامی ─────────────────────────────────────────────────────
# Public IP or domain of the server — it goes into the client Endpoint and the
# proxy link.
#   ⚠️ Leave this EMPTY and the first boot calls https://ifconfig.me — an
#      outbound request to a third party that reveals the new server's IP to
#      them. Setting it here avoids that request entirely. Set it.
# آدرس یا دامنه‌ی عمومیِ سرور — در Endpoint کانفیگِ کلاینت‌ها می‌نشیند.
#   ⚠️ اگر **خالی** بماند، نخستین بوت به https://ifconfig.me درخواست می‌زند —
#      یعنی یک سرویسِ شخصِ ثالث می‌فهمد سروری با آن IP بالا آمده. با پرکردنِ
#      همین خط، آن درخواست اصلاً زده نمی‌شود. پرش کنید.
WG_SERVER_HOST=

# ── Panel · پنل ──────────────────────────────────────────────────────────
WG_PANEL_PORT=8787
WG_PANEL_ADMIN_USER=admin
# Self-signed TLS: the browser warns once, but the traffic is encrypted.
# TLS ِ self-signed — اخطارِ مرورگر در نخستین بازدید، ولی ترافیک رمز می‌شود.
WG_TLS_ENABLED=true
# If set, the panel answers only these IPs/ranges (comma-separated).
# NOTE: ufw does not filter docker-published ports — this is where you restrict.
# اگر پر شود، پنل فقط به این IP/رنج‌ها پاسخ می‌دهد؛ ufw اینجا کمکی نمی‌کند.
WG_PANEL_ALLOW_IPS=
# Short display name of the server in the bot and alerts (empty = hostname).
# نامِ نمایشیِ کوتاهِ سرور در ربات/هشدار (خالی = hostname).
WG_SERVER_LABEL=

# ── Client WireGuard · وایرگاردِ کاربران ─────────────────────────────────
WG_IFACE=wg1udp
WG_PORT=51820
WG_SUBNET=10.66.66.0/24
WG_GATEWAY_IP=10.66.66.1
WG_CLIENT_DNS=1.1.1.1, 8.8.8.8
# NAT egress interface inside the container — always eth0 on a bridge network.
# اینترفیسِ خروجیِ NAT داخلِ کانتینر — با شبکه‌ی bridge همیشه eth0 است.
WG_WAN_IFACE=eth0

# ── fail2ban — bans failed panel logins, on the panel port only ──────────
# بنِ ورودهای ناموفقِ پنل، فقط روی پورتِ خودِ پنل.
WG_F2B_ENABLED=true

# ── Automatic backup · بکاپِ خودکار ──────────────────────────────────────
# The container has no systemd, so a small scheduler inside it replaces
# wg-panel-backup.timer. Archives land in ./data/backups (14 kept, mode 600).
# A brand-new install also runs one backup ~10 min after the first boot so the
# install is never left without a safety net for a whole day.
# کانتینر systemd ندارد، پس یک زمان‌بندِ کوچک داخلش جانشینِ
# wg-panel-backup.timer است. آرشیوها در ./data/backups (۱۴ نسخه، مود ۶۰۰).
# نصبِ تازه یک بکاپ هم ۱۰ دقیقه پس از نخستین بوت می‌گیرد تا هیچ نصبی یک
# شبانه‌روز بی‌تورِ ایمنی نماند.
WG_BACKUP_ENABLED=true
# Local time (HH:MM, uses TZ below). Panel's backup page shows the next run.
# ساعتِ محلی (HH:MM، طبقِ TZ پایین). «اجرای بعدی» در صفحه‌ی بکاپ دیده می‌شود.
WG_BACKUP_AT=04:30
# Cloud upload time — only runs if the two MEGA S4 secret files are mounted
# (see the volumes section of docker-compose.yml); otherwise it is skipped
# silently, which is correct for an install without cloud backup.
# ساعتِ آپلودِ ابری — فقط اگر دو فایلِ رازِ MEGA S4 mount شده باشند اجرا
# می‌شود، وگرنه بی‌صدا رد می‌شود (که برای نصبِ بدونِ ابر درست است).
WG_S4_UPLOAD_AT=04:55

# ── Telegram (optional — empty = off) · تلگرام (اختیاری) ────────────────
# token + owner_id ⇒ the management bot. token + chat_id ⇒ alerts.
WG_BOT_TOKEN=
WG_BOT_CHAT_ID=
WG_BOT_OWNER_ID=

# ── Container details (rarely needed) · جزئیاتِ کانتینر ─────────────────
WG_HOSTNAME=wg-panel
# Internal compose network subnet; change only if it clashes with your LAN.
# سابنتِ شبکه‌ی داخلیِ compose؛ فقط در صورتِ تداخل عوضش کنید.
WG_DOCKER_SUBNET=172.29.101.0/24
TZ=Asia/Tehran

# ── Rarely needed · به‌ندرت لازم ─────────────────────────────────────────
# Name of the "full server backup" group (archive dir + systemd unit + MEGA
# prefix). The image ships no full-backup script, so this row stays empty in
# the backup page — that is expected, not a fault. Change it only if you mount
# your own <name>-backup.service.
# نامِ گروهِ «بکاپِ کاملِ سرور» (پوشه‌ی آرشیو + یونیت + پیشوندِ MEGA). ایمیج
# اسکریپتِ بکاپِ کامل ندارد، پس آن ردیف در صفحه‌ی بکاپ خالی می‌ماند — طبیعی
# است نه خرابی. فقط اگر یونیتِ خودتان را mount کردید عوضش کنید.
WG_FULL_BACKUP_NAME=wg-panel-full
# CIDR of an external VPN pool (e.g. an AnyConnect range) whose IPs have no
# WireGuard peer — they get a generic label in the per-user WARP table.
# Empty = no such pool, which is the normal case for a fresh install.
# رنجِ استخرِ VPN ِ بیرونی (مثلاً AnyConnect) که IPهایش پیرِ وایرگارد ندارند
# و در جدولِ per-user برچسبِ عمومی می‌گیرند. خالی = چنین استخری ندارید.
WG_VPN_POOL=

# ── What this image deliberately does NOT carry ──────────────────────────
# Three panel pages stay empty or show an error here. None of them is a
# malfunction, and none affects VPN service, users, quotas or the proxy:
#   • Speed test — needs Ookla's CLI, which is not in the Ubuntu repository.
#     Mount your own binary (see docker-compose.yml) to switch the page on.
#   • Full server backup — that script backs up a whole host (letsencrypt,
#     units, /etc); a container has no such host. Panel backups DO run.
#   • Backup verification — the shipped verifier is MEGA-only and enforces
#     "no backup file stays on the server", which is the opposite of this
#     install's design (backups are kept in ./data/backups on purpose).
# آنچه این ایمیج آگاهانه ندارد — سه ردیف/صفحه خالی می‌ماند و هیچ‌کدام خرابی
# نیست و به سرویسِ VPN، کاربران، سهمیه و پروکسی کاری ندارد:
#   • تستِ سرعت: CLI ِ Ookla در مخزنِ اوبونتو نیست؛ با mountِ باینری روشن می‌شود.
#   • بکاپِ کاملِ سرور: آن اسکریپت یک میزبانِ کامل را می‌گیرد و کانتینر چنین
#     میزبانی ندارد. بکاپِ خودِ پنل اجرا می‌شود.
#   • راستی‌آزماییِ بکاپ: نسخه‌ی موجود فقط MEGA-محور است و قاعده‌ی «هیچ بکاپی
#     روی سرور نماند» را اعمال می‌کند — عکسِ طرحِ همین نصب که بکاپ را عمداً
#     در ./data/backups نگه می‌دارد.
