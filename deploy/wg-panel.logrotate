# چرخشِ لاگِ عملیاتِ پنل — نصب در /etc/logrotate.d/wg-panel
#
# سورس: deploy/wg-panel.logrotate → /etc/logrotate.d/wg-panel  (مود ۶۴۴)
#
# چرا لازم است با اینکه پنل چرخشِ داخلی دارد:
# `log_action()` بالای ۱MB فایل را به `actions.log.1` منتقل می‌کند و همان یک
# نسخه را نگه می‌دارد. آن یک **شیرِ اطمینانِ ضدِ رشدِ انفجاری** است، نه
# بایگانی: تاریخچه‌ی قدیمی‌تر از ~۲MB برای همیشه از دست می‌رود، و در ۴ اوت
# ۲۰۲۶ اندازه‌گیری شد که فایل ۱۹ روزه فقط ۲۹۸KB است — یعنی آن آستانه عملاً
# هرگز نمی‌رسد و ردِ ممیزی ماه‌ها در یک فایلِ فشرده‌نشده می‌مانَد.
#
# این قاعده تاریخچه‌ی یک‌ساله‌ی فشرده می‌دهد بدونِ آنکه شیرِ اطمینان را لمس کند.
#
# ⚠️ عمداً `copytruncate` **نیست**: `log_action()` هر بار
# `open(path, "a")` می‌کند و دستگیره نگه نمی‌دارد (با `lsof` تأیید شد: هیچ
# پروسه‌ای فایل را باز نگه نداشته). پس چرخشِ مبتنی بر rename امن است و
# نوشتنِ بعدی خودش فایلِ تازه را می‌سازد. `copytruncate` اینجا فقط پنجره‌ی
# از دست رفتنِ خط بینِ کپی و truncate را اضافه می‌کرد.
/opt/wg-panel/actions.log {
    monthly
    rotate 12
    compress
    delaycompress
    notifempty
    missingok
    # فایل مالکِ root:root و مود ۶۴۴ است؛ همان را بازتولید کن.
    create 0644 root root
    # /opt/wg-panel مالکِ root است و logrotate باید صریحاً بداند.
    su root root
}
